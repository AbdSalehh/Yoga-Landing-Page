---
import { AppButton } from "@/shared/ui";

const footerGroups = [
  {
    title: "Inspiration",
    links: ["Online yoga", "Online meditation", "Classes", "Yoga poses"],
  },
  {
    title: "Company",
    links: ["Our purpose", "Our team", "Career", "Journal"],
  },
  {
    title: "Support",
    links: ["Contact us", "FAQs", "Membership", "Class schedule"],
  },
];

const callToActionRibbonPhrase =
  "Individuals of all experience levels • Designed to enhance flexibility • Build strength and promote deep relaxation • ";

const callToActionRibbonText = callToActionRibbonPhrase.repeat(4);
---

<section
  id="contact"
  data-motion-section
  class="motion-reveal scroll-mt-28 bg-white pt-4"
>
  <div
    class="relative overflow-hidden rounded-[2.25rem] bg-linear-to-r from-[#ebe9f8] via-[#f1ecfb] to-[#f5f3ff] px-7 pb-10 sm:px-12 lg:px-16"
  >
    <svg
      viewBox="0 0 1500 520"
      preserveAspectRatio="xMidYMid slice"
      class="pointer-events-none absolute inset-x-0 top-0 h-125 w-full sm:h-135"
      aria-hidden="true"
    >
      <path
        id="cta-ribbon"
        d="M-100 260Q750 -140 1600 260"
        fill="none"
        stroke="#7968ae"
        stroke-width="42"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <text
        fill="white"
        font-size="13.5"
        font-weight="500"
        letter-spacing="0.7"
      >
        <textPath href="#cta-ribbon" startOffset="0%">
          {callToActionRibbonText}
          <animate
            attributeName="startOffset"
            from="0%"
            to="-25%"
            dur="24s"
            repeatCount="indefinite"></animate>
        </textPath>
      </text>
    </svg>

    <div
      class="relative z-10 mx-auto flex min-h-100 max-w-3xl flex-col items-center justify-start pt-32 text-center sm:min-h-100 sm:pt-36"
    >
      <h2
        data-motion-item
        class="mx-auto max-w-2xl text-4xl leading-[0.94] font-medium tracking-tighter sm:text-5xl"
      >
        Improve flexibility, strength, and peace.
      </h2>
      <div data-motion-item>
        <AppButton href="mailto:hello@serenityyoga.com" className="mt-5">
          Get started
          <span aria-hidden="true">↗</span>
        </AppButton>
      </div>
    </div>

    <footer class="relative z-10 border-t border-black/15 pt-12 pb-6">
      <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
        <!-- Brand & Newsletter -->
        <div data-motion-item class="flex flex-col items-start">
          <a href="#home" class="flex items-center gap-2.5">
            <span
              class="grid size-7 place-items-center rounded-full bg-ink text-xs font-bold text-white"
              >S</span
            >
            <span class="text-sm font-semibold tracking-[0.08em]"
              >SERENITY YOGA</span
            >
          </a>
          <p class="mt-4 max-w-xs text-xs leading-5 text-black/60">
            Empowering you to find balance and inner peace through the practice
            of yoga and mindfulness.
          </p>

          <form
            action="#"
            method="POST"
            on-submit="return false;"
            class="mt-6 flex w-full max-w-sm items-center rounded-full border border-black/15 bg-white p-1 shadow-xs"
          >
            <input
              type="email"
              placeholder="Your email address"
              required
              class="w-full bg-transparent px-4 text-xs text-black outline-none placeholder:text-black/40"
            />
            <button
              type="submit"
              class="shrink-0 rounded-full bg-[#7665ac] px-5 py-2.5 text-xs font-medium text-white transition hover:bg-[#645398]"
            >
              Subscribe
            </button>
          </form>
        </div>

        <!-- Inspiration -->
        <div data-motion-item>
          <h3 class="text-sm font-semibold text-black">Inspiration</h3>
          <ul class="mt-4 space-y-2.5 text-xs text-black/60">
            <li>
              <a href="#" class="transition hover:text-black">Online yoga</a>
            </li>
            <li>
              <a href="#" class="transition hover:text-black"
                >Online meditation</a
              >
            </li>
            <li>
              <a href="#" class="transition hover:text-black">Wellness tips</a>
            </li>
            <li>
              <a href="#" class="transition hover:text-black"
                >Meditation for beginners</a
              >
            </li>
            <li>
              <a href="#" class="transition hover:text-black"
                >Poses for beginners</a
              >
            </li>
          </ul>
        </div>

        <!-- Company -->
        <div data-motion-item>
          <h3 class="text-sm font-semibold text-black">Company</h3>
          <ul class="mt-4 space-y-2.5 text-xs text-black/60">
            <li>
              <a href="#" class="transition hover:text-black">Our purpose</a>
            </li>
            <li>
              <a href="#" class="transition hover:text-black">Our team</a>
            </li>
            <li><a href="#" class="transition hover:text-black">Career</a></li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div data-motion-item>
          <h3 class="text-sm font-semibold text-black">Contact Info</h3>
          <ul class="mt-4 space-y-2 text-xs leading-5 text-black/60">
            <li>123 Wellness Way</li>
            <li>Serenity City, SC 12345</li>
            <li class="pt-1">Phone: (123) 456-7890</li>
            <li>Email: hello@serenityyoga.com</li>
          </ul>

          <!-- Social Icons -->
          <div class="mt-5 flex items-center gap-2.5">
            <!-- Facebook -->
            <a
              href="#"
              aria-label="Facebook"
              class="grid size-8 place-items-center rounded-full bg-[#1877f2] text-white transition hover:opacity-90"
            >
              <svg class="size-4 fill-current" viewBox="0 0 24 24">
                <path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                ></path>
              </svg>
            </a>
            <!-- Instagram -->
            <a
              href="#"
              aria-label="Instagram"
              class="grid size-8 place-items-center rounded-full bg-linear-to-tr from-[#f9ce34] via-[#ee2a7b] to-[#6228d7] text-white transition hover:opacity-90"
            >
              <svg class="size-4 fill-current" viewBox="0 0 24 24">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
            </a>
            <!-- YouTube -->
            <a
              href="#"
              aria-label="YouTube"
              class="grid size-8 place-items-center rounded-full bg-[#ff0000] text-white transition hover:opacity-90"
            >
              <svg class="size-4 fill-current" viewBox="0 0 24 24">
                <path
                  d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div
        data-motion-item
        class="mt-12 flex flex-col gap-3 border-t border-black/15 pt-6 text-xs text-black/45 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>© 2026 Serenity Yoga. All rights reserved.</p>
        <div class="flex gap-5">
          <a href="#">Privacy policy</a>
          <a href="#">Terms</a>
        </div>
      </div>
    </footer>
  </div>
</section>
