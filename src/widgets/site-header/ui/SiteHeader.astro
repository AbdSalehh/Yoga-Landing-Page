---
import { MobileNavigation } from "@/features/mobile-navigation";
import { AppButton } from "@/shared/ui";

const navigationLinks = [
  { label: "About Us", href: "#about" },
  { label: "Reviews", href: "#reviews" },
  { label: "Trainers", href: "#trainers" },
  { label: "Classes", href: "#classes" },
];
---

<header class="fixed inset-x-0 top-3 z-100 mx-auto w-full px-3">
  <div class="relative mx-auto w-full max-w-[1580px]">
    <div
      class="relative flex h-16.5 w-full items-center overflow-visible rounded-full border border-white/70 bg-white/55 shadow-[0_14px_45px_rgba(31,25,25,0.14)] backdrop-blur-[32px] backdrop-saturate-150"
    >
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden rounded-full bg-linear-to-b from-white/55 via-white/15 to-white/5"
      >
      </div>

      <div
        class="relative z-10 flex w-full items-center justify-between gap-6 px-5 sm:px-7"
      >
        <a href="#home" class="flex items-center gap-2.5">
          <span
            class="grid size-7 place-items-center rounded-full bg-ink text-xs font-bold text-white"
            >S</span
          >
          <span class="text-sm font-semibold tracking-[0.08em]"
            >SERENITY YOGA</span
          >
        </a>

        <nav
          class="hidden items-center gap-2 md:flex"
          aria-label="Navigasi utama"
        >
          {
            navigationLinks.map((navigationLink) => (
              <a
                href={navigationLink.href}
                class="rounded-full bg-white px-5 py-2 text-xs font-medium text-black shadow-xs transition duration-200 hover:bg-white/90 hover:shadow-md"
              >
                {navigationLink.label}
              </a>
            ))
          }
        </nav>

        <div class="hidden md:block">
          <AppButton
            href="#classes"
            variant="outline"
            className="border-white/60 bg-white/50 py-2.5 text-xs"
          >
            Join a class
          </AppButton>
        </div>

        <MobileNavigation navigationLinks={navigationLinks} client:load />
      </div>
    </div>
  </div>
</header>
