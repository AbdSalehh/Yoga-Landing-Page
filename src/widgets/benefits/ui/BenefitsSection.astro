---
import { Image } from "astro:assets";
import {
  flexibilityYogaImage,
  groupYogaImage,
  mindfulYogaImage,
} from "@/shared/assets/images/yoga";
import { AppButton } from "@/shared/ui";

const benefits = [
  {
    title: "Improved Flexibility",
    alt: "Woman improving flexibility through a yoga pose",
    image: flexibilityYogaImage,
  },
  {
    title: "Stress Reduction",
    alt: "Woman practicing mindful yoga",
    image: mindfulYogaImage,
  },
];
---

<section
  id="classes"
  data-motion-section
  class="motion-stagger scroll-mt-28 bg-white pb-4"
>
  <div class="grid gap-4 lg:grid-cols-[0.78fr_0.92fr_1.3fr]">
    {
      benefits.map((benefit) => (
        <article
          data-motion-item
          class="motion-card group relative min-h-105 overflow-hidden rounded-4xl"
        >
          <Image
            src={benefit.image}
            alt={benefit.alt}
            loading="lazy"
            class="absolute inset-0 size-full rounded-4xl object-cover transition duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-x-5 top-5 flex items-center justify-between">
            <span class="rounded-full bg-white px-4 py-2 text-xs font-semibold">
              View video
            </span>
            <span class="grid size-11 place-items-center rounded-full bg-white text-lg">
              ↗
            </span>
          </div>
          <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent p-7 pt-32 text-white">
            <h2 class="text-3xl font-medium tracking-[-0.04em]">
              {benefit.title}
            </h2>
          </div>
        </article>
      ))
    }

    <article
      data-motion-item
      class="motion-card relative min-h-105 overflow-hidden rounded-4xl"
    >
      <Image
        src={groupYogaImage}
        alt="Students practicing yoga together in a studio"
        loading="lazy"
        class="absolute inset-0 size-full rounded-4xl object-cover"
      />
      <div
        class="absolute inset-0 bg-linear-to-t from-black/82 via-black/5 to-transparent"
      >
      </div>
      <div class="absolute inset-x-7 bottom-7 text-white">
        <span class="text-xs tracking-[0.18em] text-white/70 uppercase"
          >Join our class</span
        >
        <h2
          class="mt-3 max-w-md text-4xl leading-[0.98] font-medium tracking-tighter"
        >
          Join Us for a Yoga Class Today!
        </h2>
        <div class="mt-6 flex items-center gap-2 rounded-full bg-white p-1.5">
          <span class="min-w-0 flex-1 px-4 text-sm text-black/45"
            >Your email</span
          >
          <AppButton href="#contact" className="px-4 py-2.5 text-xs"
            >Get started</AppButton
          >
        </div>
      </div>
    </article>
  </div>
</section>
