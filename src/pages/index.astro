---
import BaseLayout from "@/app/layouts/BaseLayout.astro";
import { BenefitsSection } from "@/widgets/benefits";
import { CtaFooterSection } from "@/widgets/cta-footer";
import { EventsSection } from "@/widgets/events";
import { FaqSection } from "@/widgets/faq";
import { HeroSection } from "@/widgets/hero";
import { SiteHeader } from "@/widgets/site-header";
import { TestimonialsSection } from "@/widgets/testimonials";
import { TrainersSection } from "@/widgets/trainers";
---

<BaseLayout>
  <SiteHeader />

  <main
    class="mx-auto w-full max-w-[1680px] bg-white px-2 pb-3 sm:px-3 lg:px-4"
  >
    <HeroSection />
    <BenefitsSection />
    <TestimonialsSection />
    <TrainersSection />
    <EventsSection />
    <FaqSection />
    <CtaFooterSection />
  </main>
</BaseLayout>

<script>
  import { animate, inView, stagger } from "motion";

  // Force scroll to top on refresh/load
  if (typeof window !== "undefined") {
    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual";
    }
    window.scrollTo(0, 0);
    window.addEventListener("beforeunload", () => {
      window.scrollTo(0, 0);
    });
  }

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    const animatedSections = new WeakSet<HTMLElement>();

    document
      .querySelectorAll<HTMLElement>("[data-motion-section]")
      .forEach((sectionElement) => {
        const itemElements =
          sectionElement.querySelectorAll<HTMLElement>("[data-motion-item]");

        if (itemElements.length > 0) {
          animate(
            itemElements,
            {
              opacity: 0,
              y: 36,
              scale: 0.98,
            },
            {
              duration: 0,
            },
          );
        }

        inView(
          sectionElement,
          () => {
            if (animatedSections.has(sectionElement)) {
              return;
            }

            animatedSections.add(sectionElement);
            if (itemElements.length > 0) {
              animate(
                itemElements,
                {
                  opacity: [0, 1],
                  y: [36, 0],
                  scale: [0.98, 1],
                },
                {
                  duration: 0.85,
                  delay: stagger(0.08),
                  ease: [0.16, 1, 0.3, 1],
                },
              );
            }
          },
          {
            amount: 0.12,
          },
        );
      });

    document
      .querySelectorAll<HTMLElement>(".motion-float")
      .forEach((floatingElement, floatingIndex) => {
        animate(
          floatingElement,
          {
            y: [0, -8 - floatingIndex * 2, 0],
            rotate: [0, floatingIndex % 2 === 0 ? 2 : -2, 0],
          },
          {
            duration: 6 + floatingIndex * 0.6,
            repeat: Infinity,
            ease: "easeInOut",
          },
        );
      });
  }
</script>
