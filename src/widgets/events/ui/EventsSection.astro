---
import { Image } from "astro:assets";
import {
  outdoorRetreatImage,
  wellnessRetreatImage,
} from "@/shared/assets/images/yoga";
import { AppButton } from "@/shared/ui";

const events = [
  {
    title: "Relax and Rejuvenate",
    alt: "Yoga retreat class in a peaceful outdoor setting",
    image: outdoorRetreatImage,
  },
  {
    title: "Women's Wellness Yoga Retreat",
    alt: "Women supporting each other during a wellness class",
    image: wellnessRetreatImage,
  },
];
---

<section data-motion-section class="motion-reveal bg-white py-4">
  <div
    class="overflow-hidden rounded-[2.25rem] bg-black px-7 py-12 text-white sm:px-12 lg:px-16 lg:py-16"
  >
    <div class="grid items-center gap-12 lg:grid-cols-[0.72fr_1.28fr]">
      <div>
        <span
          data-motion-item
          class="inline-flex rounded-full border border-white/30 px-4 py-2 text-xs text-white/75"
        >
          Community experiences
        </span>
        <h2
          data-motion-item
          class="mt-7 text-5xl leading-[0.92] font-medium tracking-[-0.055em] sm:text-6xl"
        >
          Workshops and events.
        </h2>
        <p
          data-motion-item
          class="mt-6 max-w-md text-sm leading-6 text-white/55"
        >
          Join our upcoming workshops, retreats, and community experiences
          designed to deepen your practice.
        </p>
        <div data-motion-item>
          <AppButton href="#contact" variant="light" className="mt-8">
            View all events
            <span aria-hidden="true">↗</span>
          </AppButton>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          events.map((event) => (
            <article
              data-motion-item
              class="group relative min-h-97.5 overflow-hidden rounded-[1.8rem]"
            >
              <Image
                src={event.image}
                alt={event.alt}
                loading="lazy"
                class="absolute inset-0 size-full rounded-[1.8rem] object-cover transition duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-black/5" />
              <div class="absolute inset-x-6 bottom-6">
                <h3 class="max-w-xs text-3xl leading-none font-medium tracking-[-0.045em]">
                  {event.title}
                </h3>
                <div class="mt-5 flex items-center justify-between">
                  <span class="text-xs text-white/65">Weekend experience</span>
                  <span class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-black">
                    Register here ↗
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
